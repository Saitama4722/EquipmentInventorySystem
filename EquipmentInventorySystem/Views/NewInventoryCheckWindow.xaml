<Window x:Class="EquipmentInventorySystem.Views.NewInventoryCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:EquipmentInventorySystem.Models"
        Title="Новая инвентаризация"
        Width="960" Height="660"
        MinWidth="800" MinHeight="520"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F9">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Title ══ -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Новая инвентаризация"
                       FontSize="18" FontWeight="SemiBold"
                       FontFamily="Segoe UI"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Заполните заголовок и проставьте результаты проверки для каждой позиции."
                       FontSize="12"
                       FontFamily="Segoe UI"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ══ Check header fields ══ -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="20,14"
                Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Дата проверки *"
                           VerticalAlignment="Center"
                           FontSize="13" FontFamily="Segoe UI"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,10,0"/>
                <DatePicker Grid.Column="1"
                            x:Name="CheckDatePicker"
                            Height="34" FontSize="13" FontFamily="Segoe UI"
                            VerticalContentAlignment="Center"/>

                <TextBlock Grid.Column="3"
                           Text="Ответственный *"
                           VerticalAlignment="Center"
                           FontSize="13" FontFamily="Segoe UI"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,10,0"/>
                <ComboBox Grid.Column="4"
                          x:Name="EmployeeBox"
                          Style="{StaticResource FormComboBoxStyle}"/>

                <TextBlock Grid.Column="6"
                           Text="Примечание"
                           VerticalAlignment="Center"
                           FontSize="13" FontFamily="Segoe UI"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,10,0"/>
                <TextBox Grid.Column="7"
                         x:Name="CommentBox"
                         Style="{StaticResource FormTextBoxStyle}"/>
            </Grid>
        </Border>

        <!-- ══ Equipment list ══ -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Margin="0,12,0,0"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#F5F6FA"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,10">
                    <TextBlock Text="Список оборудования для проверки"
                               FontSize="13" FontWeight="SemiBold"
                               FontFamily="Segoe UI"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </Border>

                <DataGrid Grid.Row="1"
                          x:Name="CheckItemsGrid"
                          AutoGenerateColumns="False"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F0F0F0"
                          AlternatingRowBackground="#FAFBFC"
                          BorderThickness="0"
                          RowHeight="36"
                          ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                          RowStyle="{StaticResource DataGridRowStyle}">
                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Наименование"
                                            Binding="{Binding Name}"
                                            Width="2*"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource CellTextStyle}"/>

                        <DataGridTextColumn Header="Инв. №"
                                            Binding="{Binding InventoryNumber}"
                                            Width="100"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource CellTextStyle}"/>

                        <DataGridTextColumn Header="Статус"
                                            Binding="{Binding StatusDisplay}"
                                            Width="120"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource CellTextStyle}"/>

                        <DataGridTextColumn Header="Помещение"
                                            Binding="{Binding RoomDisplay}"
                                            Width="*"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource CellTextStyle}"/>

                        <DataGridTextColumn Header="Сотрудник"
                                            Binding="{Binding EmployeeDisplay}"
                                            Width="*"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource CellTextStyle}"/>

                        <!-- Editable: Result status -->
                        <DataGridTemplateColumn Header="Результат проверки" Width="155">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SelectedOption.Display}"
                                               Padding="10,0"
                                               VerticalAlignment="Center"
                                               FontSize="13" FontFamily="Segoe UI"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{x:Static models:InventoryCheckItemRow.StatusOptions}"
                                              SelectedItem="{Binding SelectedOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              DisplayMemberPath="Display"
                                              IsDropDownOpen="True"
                                              FontSize="13" FontFamily="Segoe UI"
                                              BorderThickness="0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <!-- Editable: Comment -->
                        <DataGridTemplateColumn Header="Примечание" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Comment}"
                                               Padding="10,0"
                                               VerticalAlignment="Center"
                                               FontSize="13" FontFamily="Segoe UI"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="8,4"
                                             FontSize="13" FontFamily="Segoe UI"
                                             BorderThickness="0"
                                             VerticalContentAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ══ Buttons ══ -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Отмена"
                    Width="90"
                    Margin="0,0,10,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="Cancel_Click"/>
            <Button Content="Сохранить инвентаризацию"
                    Padding="20,7"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Save_Click"/>
        </StackPanel>

    </Grid>
</Window>
