<UserControl x:Class="EquipmentInventorySystem.Views.InventoryChecksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource ContentBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Page header ══ -->
        <StackPanel Grid.Row="0" Margin="24,22,24,14">
            <TextBlock Text="Инвентаризации" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="Плановые и внеплановые инвентаризационные проверки."
                       Style="{StaticResource PageSubtitleStyle}" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- ══ Toolbar ══ -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,1"
                Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: info hint -->
                <TextBlock Grid.Column="0"
                           x:Name="CheckCountText"
                           VerticalAlignment="Center"
                           FontSize="13"
                           FontFamily="Segoe UI"
                           Foreground="{StaticResource TextSecondaryBrush}"/>

                <!-- Right: action buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Просмотреть"
                            Margin="0,0,6,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="ViewButton_Click"/>
                    <Button Content="Обновить"
                            Margin="0,0,6,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="RefreshButton_Click"/>
                    <Button Content="＋  Новая инвентаризация"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="NewCheckButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ DataGrid ══ -->
        <Border Grid.Row="2"
                Margin="24,16,24,16"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                ClipToBounds="True">
            <DataGrid x:Name="ChecksGrid"
                      ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F0F0F0"
                      AlternatingRowBackground="#FAFBFC"
                      BorderThickness="0"
                      RowHeight="36"
                      ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                      RowStyle="{StaticResource DataGridRowStyle}"
                      MouseDoubleClick="ChecksGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата проверки"
                                        Binding="{Binding CheckDateDisplay, Mode=OneWay}"
                                        Width="130"
                                        ElementStyle="{StaticResource CellTextStyle}"/>
                    <DataGridTextColumn Header="Ответственный сотрудник"
                                        Binding="{Binding ResponsibleEmployee}"
                                        Width="*"
                                        ElementStyle="{StaticResource CellTextStyle}"/>
                    <DataGridTextColumn Header="Позиций"
                                        Binding="{Binding ItemCount}"
                                        Width="80"
                                        ElementStyle="{StaticResource CellTextStyle}"/>
                    <DataGridTextColumn Header="Примечание"
                                        Binding="{Binding Comment}"
                                        Width="2*"
                                        ElementStyle="{StaticResource CellTextStyle}"/>
                    <DataGridTextColumn Header="Дата создания"
                                        Binding="{Binding CreatedAtDisplay, Mode=OneWay}"
                                        Width="140"
                                        ElementStyle="{StaticResource CellTextStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

    </Grid>
</UserControl>
