<Window x:Class="EquipmentInventorySystem.Views.TransferEquipmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Перемещение оборудования"
        Width="490" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F9">

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Title ══ -->
        <TextBlock Grid.Row="0"
                   Text="Перемещение оборудования"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   FontFamily="Segoe UI"/>

        <!-- ══ Current assignment info ══ -->
        <Border Grid.Row="1"
                Background="#EEF5FF"
                BorderBrush="#BBDEFB"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16,14"
                Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Оборудование:"
                           FontSize="12" FontFamily="Segoe UI"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="1"
                           x:Name="EquipmentNameText"
                           FontSize="13" FontFamily="Segoe UI"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="Инв. номер:"
                           FontSize="12" FontFamily="Segoe UI"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Grid.Column="1"
                           x:Name="InventoryText"
                           FontSize="13" FontFamily="Segoe UI"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <TextBlock Grid.Row="4" Grid.Column="0"
                           Text="Помещение:"
                           FontSize="12" FontFamily="Segoe UI"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Row="4" Grid.Column="1"
                           x:Name="CurrentRoomText"
                           FontSize="13" FontFamily="Segoe UI"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <TextBlock Grid.Row="6" Grid.Column="0"
                           Text="Сотрудник:"
                           FontSize="12" FontFamily="Segoe UI"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Row="6" Grid.Column="1"
                           x:Name="CurrentEmployeeText"
                           FontSize="13" FontFamily="Segoe UI"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </Grid>
        </Border>

        <!-- ══ Transfer form ══ -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="20,16"
                Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="138"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- New Room -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Новое помещение"
                           VerticalAlignment="Center"
                           FontSize="13" FontFamily="Segoe UI"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <ComboBox  Grid.Row="0" Grid.Column="1"
                           x:Name="RoomBox"
                           Style="{StaticResource FormComboBoxStyle}"/>

                <!-- New Employee -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="Новый сотрудник"
                           VerticalAlignment="Center"
                           FontSize="13" FontFamily="Segoe UI"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <ComboBox  Grid.Row="2" Grid.Column="1"
                           x:Name="EmployeeBox"
                           Style="{StaticResource FormComboBoxStyle}"/>

                <!-- Date -->
                <TextBlock Grid.Row="4" Grid.Column="0"
                           Text="Дата перемещения *"
                           VerticalAlignment="Center"
                           FontSize="13" FontFamily="Segoe UI"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <DatePicker Grid.Row="4" Grid.Column="1"
                            x:Name="MovedAtPicker"
                            Height="34"
                            FontSize="13"
                            FontFamily="Segoe UI"
                            VerticalContentAlignment="Center"/>

                <!-- Comment -->
                <TextBlock Grid.Row="6" Grid.Column="0"
                           Text="Комментарий"
                           VerticalAlignment="Top"
                           Margin="0,8,0,0"
                           FontSize="13" FontFamily="Segoe UI"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBox   Grid.Row="6" Grid.Column="1"
                           x:Name="CommentBox"
                           Height="64"
                           Padding="8,6"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           VerticalScrollBarVisibility="Auto"
                           FontSize="13" FontFamily="Segoe UI"
                           BorderBrush="#BDBDBD" BorderThickness="1"
                           VerticalContentAlignment="Top"/>
            </Grid>
        </Border>

        <!-- ══ Buttons ══ -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Отмена"
                    Width="90"
                    Margin="0,0,10,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="Cancel_Click"/>
            <Button Content="Записать перемещение"
                    Padding="18,7"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Save_Click"/>
        </StackPanel>

    </Grid>
</Window>
