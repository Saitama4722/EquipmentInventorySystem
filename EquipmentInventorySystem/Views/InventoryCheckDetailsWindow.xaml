<Window x:Class="EquipmentInventorySystem.Views.InventoryCheckDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Результаты инвентаризации"
        Width="860" Height="580"
        MinWidth="700" MinHeight="440"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F9">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Title ══ -->
        <TextBlock Grid.Row="0"
                   x:Name="WindowTitleText"
                   FontSize="18" FontWeight="SemiBold"
                   FontFamily="Segoe UI"
                   Foreground="{StaticResource TextPrimaryBrush}"/>

        <!-- ══ Check header info ══ -->
        <Border Grid.Row="1"
                Background="#EEF5FF"
                BorderBrush="#BBDEFB"
                BorderThickness="1"
                CornerRadius="6"
                Padding="18,14"
                Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Дата проверки: "
                               FontSize="13" FontFamily="Segoe UI"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="DateText"
                               FontSize="13" FontFamily="Segoe UI"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Ответственный: "
                               FontSize="13" FontFamily="Segoe UI"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="EmployeeText"
                               FontSize="13" FontFamily="Segoe UI"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Позиций проверено: "
                               FontSize="13" FontFamily="Segoe UI"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="ItemCountText"
                               FontSize="13" FontFamily="Segoe UI"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Примечание: "
                               FontSize="13" FontFamily="Segoe UI"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="CommentText"
                               FontSize="13" FontFamily="Segoe UI"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Items grid ══ -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Margin="0,12,0,0"
                ClipToBounds="True">
            <DataGrid x:Name="ItemsGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F0F0F0"
                      AlternatingRowBackground="#FAFBFC"
                      BorderThickness="0"
                      RowHeight="36"
                      ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                      RowStyle="{StaticResource DataGridRowStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Наименование"
                                        Binding="{Binding EquipmentName}"
                                        Width="2*"
                                        ElementStyle="{StaticResource CellTextStyle}"/>
                    <DataGridTextColumn Header="Инв. №"
                                        Binding="{Binding InventoryNumber}"
                                        Width="100"
                                        ElementStyle="{StaticResource CellTextStyle}"/>
                    <DataGridTextColumn Header="Помещение"
                                        Binding="{Binding RoomDisplay}"
                                        Width="*"
                                        ElementStyle="{StaticResource CellTextStyle}"/>
                    <DataGridTextColumn Header="Сотрудник"
                                        Binding="{Binding EmployeeDisplay}"
                                        Width="*"
                                        ElementStyle="{StaticResource CellTextStyle}"/>
                    <DataGridTextColumn Header="Результат"
                                        Binding="{Binding ResultStatusDisplay}"
                                        Width="130"
                                        ElementStyle="{StaticResource CellTextStyle}"/>
                    <DataGridTextColumn Header="Примечание"
                                        Binding="{Binding Comment}"
                                        Width="*"
                                        ElementStyle="{StaticResource CellTextStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ══ Close button ══ -->
        <StackPanel Grid.Row="3"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Закрыть"
                    Width="100"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="Close_Click"/>
        </StackPanel>

    </Grid>
</Window>
