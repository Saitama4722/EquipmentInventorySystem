<Window x:Class="EquipmentInventorySystem.Views.AddEditEquipmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оборудование"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F9">

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Title ══ -->
        <TextBlock x:Name="FormTitle"
                   Grid.Row="0"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   FontFamily="Segoe UI"
                   Margin="0,0,0,20"/>

        <!-- ══ Form fields ══ -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="135"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Name -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Наименование *"
                           VerticalAlignment="Center"
                           FontSize="13" FontFamily="Segoe UI"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBox   Grid.Row="0" Grid.Column="1"
                           x:Name="NameBox"
                           Style="{StaticResource FormTextBoxStyle}"/>

                <!-- Inventory Number -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="Инв. номер *"
                           VerticalAlignment="Center"
                           FontSize="13" FontFamily="Segoe UI"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBox   Grid.Row="2" Grid.Column="1"
                           x:Name="InventoryNumberBox"
                           Style="{StaticResource FormTextBoxStyle}"/>

                <!-- Serial Number -->
                <TextBlock Grid.Row="4" Grid.Column="0"
                           Text="Серийный номер"
                           VerticalAlignment="Center"
                           FontSize="13" FontFamily="Segoe UI"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBox   Grid.Row="4" Grid.Column="1"
                           x:Name="SerialNumberBox"
                           Style="{StaticResource FormTextBoxStyle}"/>

                <!-- Status -->
                <TextBlock Grid.Row="6" Grid.Column="0"
                           Text="Статус"
                           VerticalAlignment="Center"
                           FontSize="13" FontFamily="Segoe UI"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <ComboBox  Grid.Row="6" Grid.Column="1"
                           x:Name="StatusBox"
                           Style="{StaticResource FormComboBoxStyle}"/>

                <!-- Room -->
                <TextBlock Grid.Row="8" Grid.Column="0"
                           Text="Помещение"
                           VerticalAlignment="Center"
                           FontSize="13" FontFamily="Segoe UI"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <ComboBox  Grid.Row="8" Grid.Column="1"
                           x:Name="RoomBox"
                           Style="{StaticResource FormComboBoxStyle}"/>

                <!-- Employee -->
                <TextBlock Grid.Row="10" Grid.Column="0"
                           Text="Сотрудник"
                           VerticalAlignment="Center"
                           FontSize="13" FontFamily="Segoe UI"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <ComboBox  Grid.Row="10" Grid.Column="1"
                           x:Name="EmployeeBox"
                           Style="{StaticResource FormComboBoxStyle}"/>

                <!-- Notes -->
                <TextBlock Grid.Row="12" Grid.Column="0"
                           Text="Примечания"
                           VerticalAlignment="Top"
                           Margin="0,8,0,0"
                           FontSize="13" FontFamily="Segoe UI"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBox   Grid.Row="12" Grid.Column="1"
                           x:Name="NotesBox"
                           Height="70"
                           Padding="8,6"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           VerticalScrollBarVisibility="Auto"
                           FontSize="13" FontFamily="Segoe UI"
                           BorderBrush="#BDBDBD" BorderThickness="1"
                           VerticalContentAlignment="Top"/>
            </Grid>
        </Border>

        <!-- ══ Buttons ══ -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Отмена"
                    Width="90"
                    Margin="0,0,10,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="Cancel_Click"/>
            <Button Content="Сохранить"
                    Width="100"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Save_Click"/>
        </StackPanel>

    </Grid>
</Window>
