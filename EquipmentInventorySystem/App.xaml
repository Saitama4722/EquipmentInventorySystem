<Application x:Class="EquipmentInventorySystem.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- ═══════════════ Brushes ═══════════════ -->
        <SolidColorBrush x:Key="SidebarBackgroundBrush"  Color="#1E2A3A"/>
        <SolidColorBrush x:Key="SidebarHoverBrush"       Color="#263548"/>
        <SolidColorBrush x:Key="SidebarSelectedBrush"    Color="#1565C0"/>
        <SolidColorBrush x:Key="SidebarAccentBrush"      Color="#FFFFFF"/>
        <SolidColorBrush x:Key="HeaderBackgroundBrush"   Color="#1565C0"/>
        <SolidColorBrush x:Key="ContentBackgroundBrush"  Color="#F4F6F9"/>
        <SolidColorBrush x:Key="CardBackgroundBrush"     Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush"             Color="#E0E0E0"/>
        <SolidColorBrush x:Key="TextPrimaryBrush"        Color="#212121"/>
        <SolidColorBrush x:Key="TextSecondaryBrush"      Color="#757575"/>
        <SolidColorBrush x:Key="AccentBrush"             Color="#1565C0"/>

        <!-- ═══════════════ Navigation Button (RadioButton) ═══════════════ -->
        <Style x:Key="NavButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground"           Value="#B0BEC5"/>
            <Setter Property="FontSize"             Value="13.5"/>
            <Setter Property="FontFamily"           Value="Segoe UI"/>
            <Setter Property="Height"               Value="44"/>
            <Setter Property="Cursor"               Value="Hand"/>
            <Setter Property="GroupName"            Value="Navigation"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Background="Transparent"
                                BorderThickness="0">
                            <Grid>
                                <Rectangle x:Name="Accent"
                                           Width="3"
                                           HorizontalAlignment="Left"
                                           Fill="{StaticResource SidebarAccentBrush}"
                                           Visibility="Hidden"/>
                                <TextBlock x:Name="Label"
                                           Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           Margin="22,0,8,0"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"  Property="Background"
                                        Value="{StaticResource SidebarHoverBrush}"/>
                                <Setter TargetName="Label" Property="Foreground" Value="#ECEFF1"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root"   Property="Background"
                                        Value="{StaticResource SidebarSelectedBrush}"/>
                                <Setter TargetName="Accent" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Label"  Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="Label"  Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════ Page Title ═══════════════ -->
        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- ═══════════════ Page Subtitle ═══════════════ -->
        <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize"      Value="13"/>
            <Setter Property="Foreground"    Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontFamily"    Value="Segoe UI"/>
            <Setter Property="TextWrapping"  Value="Wrap"/>
        </Style>

        <!-- ═══════════════ Info Card (Border) ═══════════════ -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background"       Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush"      Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="CornerRadius"     Value="6"/>
            <Setter Property="Padding"          Value="20"/>
        </Style>

        <!-- ═══════════════ Section Separator ═══════════════ -->
        <Style x:Key="SidebarSeparatorStyle" TargetType="Separator">
            <Setter Property="Background"  Value="#2E3F52"/>
            <Setter Property="Margin"      Value="16,6"/>
            <Setter Property="Height"      Value="1"/>
        </Style>

        <!-- ═══════════════ Button base template ═══════════════ -->
        <ControlTemplate x:Key="FlatButtonTemplate" TargetType="Button">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Root" Property="Opacity" Value="0.87"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Root" Property="Opacity" Value="0.72"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Primary button — blue fill -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background"       Value="#1565C0"/>
            <Setter Property="Foreground"       Value="White"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="FontFamily"       Value="Segoe UI"/>
            <Setter Property="Padding"          Value="18,7"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template"         Value="{StaticResource FlatButtonTemplate}"/>
        </Style>

        <!-- Secondary button — outlined -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background"       Value="White"/>
            <Setter Property="Foreground"       Value="#212121"/>
            <Setter Property="BorderBrush"      Value="#BDBDBD"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="FontFamily"       Value="Segoe UI"/>
            <Setter Property="Padding"          Value="16,6"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template"         Value="{StaticResource FlatButtonTemplate}"/>
        </Style>

        <!-- Danger button — red fill -->
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background"       Value="#C62828"/>
            <Setter Property="Foreground"       Value="White"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="FontFamily"       Value="Segoe UI"/>
            <Setter Property="Padding"          Value="16,7"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template"         Value="{StaticResource FlatButtonTemplate}"/>
        </Style>

        <!-- ═══════════════ DataGrid column header ═══════════════ -->
        <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background"         Value="#F5F6FA"/>
            <Setter Property="Foreground"         Value="#424242"/>
            <Setter Property="FontWeight"         Value="SemiBold"/>
            <Setter Property="FontSize"           Value="12.5"/>
            <Setter Property="FontFamily"         Value="Segoe UI"/>
            <Setter Property="Height"             Value="38"/>
            <Setter Property="Padding"            Value="10,0"/>
            <Setter Property="BorderBrush"        Value="#E0E0E0"/>
            <Setter Property="BorderThickness"    Value="0,0,0,1"/>
            <Setter Property="SeparatorBrush"     Value="#E0E0E0"/>
        </Style>

        <!-- ═══════════════ DataGrid row ═══════════════ -->
        <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                    <Setter Property="Foreground" Value="#0D47A1"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F9FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══════════════ Form TextBox ═══════════════ -->
        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height"                  Value="34"/>
            <Setter Property="Padding"                 Value="8,4"/>
            <Setter Property="BorderBrush"             Value="#BDBDBD"/>
            <Setter Property="BorderThickness"         Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize"                Value="13"/>
            <Setter Property="FontFamily"              Value="Segoe UI"/>
        </Style>

        <!-- ═══════════════ DataGrid cell text ═══════════════ -->
        <Style x:Key="CellTextStyle" TargetType="TextBlock">
            <Setter Property="Padding"             Value="10,0"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="FontSize"            Value="13"/>
            <Setter Property="FontFamily"          Value="Segoe UI"/>
        </Style>

        <!-- ═══════════════ Form ComboBox ═══════════════ -->
        <Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height"       Value="34"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="FontFamily"   Value="Segoe UI"/>
            <Setter Property="Padding"      Value="6,4"/>
            <Setter Property="BorderBrush"  Value="#BDBDBD"/>
        </Style>

        <!-- ═══════════════ Search TextBox with placeholder (Tag = hint text) ═══════════════ -->
        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Height"                   Value="34"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="FontFamily"               Value="Segoe UI"/>
            <Setter Property="BorderBrush"              Value="#BDBDBD"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding"                  Value="8,4"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <TextBlock x:Name="placeholder"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="#BDBDBD"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           VerticalAlignment="Center"
                                           Margin="2,0,0,0"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#9E9E9E"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#1565C0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════ Stat card number ═══════════════ -->
        <Style x:Key="StatNumberStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="30"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin"     Value="0,6,0,2"/>
        </Style>

    </Application.Resources>
</Application>
